:root {
}

.background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.titleSprite {
    position: absolute;
    top: auto;
    align-self: center;
    width: 1413px;
    height: 292.2px;
    translate: 0 19px;
}

.titleText {
    font-size: 61px;
    align-self: center;
    align-content: center;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/LuckiestGuy-Regular%20SDF%201.asset?fileID=11400000&guid=d5ea59005f57e1c4a8339c439a3d0f6a&type=2#LuckiestGuy-Regular SDF 1");
    translate: 0 46px;
}

.button {
    -unity-font-definition: url("project://database/Assets/Fonts/LuckiestGuy-Regular%20SDF%201.asset?fileID=11400000&guid=d5ea59005f57e1c4a8339c439a3d0f6a&type=2#LuckiestGuy-Regular SDF 1");
    width: 546px;
    height: 195px;
    font-size: 64px;
    -unity-text-align: middle-center;
    -unity-text-auto-size: none;
    align-self: center;
    align-content: auto;
    align-items: auto;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    background-image: url("project://database/Assets/Assets/UI_Pack/Sprites/Panels/14.png?fileID=21300000&guid=61238a5b17b39ad419f47217a9283620&type=3#14");
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    background-size: 80% 80%;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-duration: 0.35s;
}

.signOutButton {
    -unity-font-definition: url("project://database/Assets/Fonts/LuckiestGuy-Regular%20SDF%201.asset?fileID=11400000&guid=d5ea59005f57e1c4a8339c439a3d0f6a&type=2#LuckiestGuy-Regular SDF 1");
    width: 400px;
    height: 100px;
    position: absolute;
    right: 0.2%;
    bottom: 0.5%;
    background-color: rgb(255, 255, 255);
    border-left-color: rgb(14, 14, 14);
    border-right-color: rgb(14, 14, 14);
    border-top-color: rgb(14, 14, 14);
    border-bottom-color: rgb(14, 14, 14);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-right-radius: 21px;
    border-bottom-left-radius: 21px;
    font-size: 60px;
    -unity-text-align: middle-center;
    transition-duration: 0.35s;
}

.button:hover {
    scale: 1.1 1.1;
    align-self: center;
}

.signOutButton:hover {
    scale: 1.05 1.05;
}

.button:active {
    scale: 0.8 0.8;
}

.signOutButton:active {
    scale: 0.9 0.9;
}
